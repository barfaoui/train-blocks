# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.production.example .env.production   (gitignored), then replace every <...>.
# Generate secrets with `openssl rand -hex 32`; hex keeps them safe inside DATABASE_URL.

NODE_ENV=production

# Public domain, without scheme. Caddy gets its HTTPS certificate for it.
DOMAIN=<your-domain.com>

POSTGRES_USER=app
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=training_planning
# Host is the compose service name. User, password and database must match the values above.
DATABASE_URL=postgresql://app:<POSTGRES_PASSWORD>@postgres:5432/training_planning

# Never reuse the value from .env.example: it is public.
JWT_SECRET=<openssl rand -hex 32>

# SMTP credentials from your email provider (e.g. Brevo: smtp-relay.brevo.com, port 587).
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
MAIL_FROM="Train Blocks <no-reply@your-domain.com>"

# Where links in emails point.
PLANNER_PUBLIC_URL=https://<your-domain.com>
AUTHS_PUBLIC_URL=https://<your-domain.com>/auth

CORS_ORIGINS=https://<your-domain.com>
