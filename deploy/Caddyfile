(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The sha256 is the inline theme script of both index.html files.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+fuXgja6ErxsWemXjLAXCFtUhpu0/exgQlHeUxJxU3M='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

(front) {
	root * {args[0]}

	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@page not path /assets/*
	header @page Cache-Control no-cache

	try_files {path} /index.html
	file_server
}

{$DOMAIN} {
	encode zstd gzip
	log
	import security_headers

	@authsApi path /api/auth /api/auth/*
	handle @authsApi {
		reverse_proxy auths-service:3001
	}

	@plannerApi path /api/events /api/events/*
	handle @plannerApi {
		reverse_proxy planner-service:3003
	}

	redir /auth /auth/{?query}

	handle /auth/* {
		route {
			uri strip_prefix /auth
			import front /srv/auths
		}
	}

	handle {
		route {
			import front /srv/planner
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
