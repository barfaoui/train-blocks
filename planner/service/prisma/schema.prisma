// Custom output so `prisma generate` for this schema doesn't overwrite the
// auths service's client at the default node_modules/@prisma/client location.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["planner"]
}

enum SportType {
  RUNNING
  CYCLING
  SWIMMING
  STRENGTH
  YOGA
  OTHER

  @@schema("planner")
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
  SKIPPED

  @@schema("planner")
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  startTime   DateTime? @map("start_time") @db.Time
  endTime     DateTime? @map("end_time") @db.Time
  timezone    String    @db.VarChar(64)
  description String?
  location    String?   @db.VarChar(255)
  sportType   SportType @map("sport_type")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Recurrence: the series "root" carries the rule; every occurrence
  // (root included) shares one seriesId, so `WHERE series_id = X` alone
  // returns the whole series.
  recurrenceRule String? @map("recurrence_rule")
  seriesId       String? @map("series_id") @db.Uuid
  series         Event?  @relation("EventSeries", fields: [seriesId], references: [id], onDelete: Cascade)
  occurrences    Event[] @relation("EventSeries")

  trainingPlanId String?       @map("training_plan_id") @db.Uuid
  trainingPlan   TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)

  participants EventParticipant[]

  @@index([seriesId])
  @@index([startDate])
  @@map("events")
  @@schema("planner")
}

model EventParticipant {
  eventId String            @map("event_id") @db.Uuid
  userId  String            @map("user_id") @db.Uuid
  status  ParticipantStatus @default(PENDING)

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminders EventReminder[]

  @@id([eventId, userId])
  @@map("event_participants")
  @@schema("planner")
}

model EventReminder {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  minutesBefore Int      @map("minutes_before")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  participant EventParticipant @relation(fields: [eventId, userId], references: [eventId, userId], onDelete: Cascade)

  @@unique([eventId, userId, minutesBefore])
  @@map("event_reminders")
  @@schema("planner")
}

model TrainingPlan {
  id          String    @id @default(uuid()) @db.Uuid
  sportType   SportType @map("sport_type")
  notes       String?
  details     Json
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  events Event[]

  @@map("training_plans")
  @@schema("planner")
}
