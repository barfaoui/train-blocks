// Custom output so `prisma generate` for this schema doesn't overwrite the
// auths service's client at the default node_modules/@prisma/client location.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["planner"]
}

enum SportType {
  // Running
  OUTSIDE_RUNNING
  TRAIL_RUNNING
  TREADMILL
  MARATHON
  // Walking
  WALKING
  HIKING
  // Cycling
  STATIC_CYCLING
  BIKING
  MOUNTAIN_BIKING
  // Water
  SWIMMING
  WATER_POLO
  DIVING
  SCUBA
  ROWING
  KAYAKING
  SAILING
  SURFING
  // Fitness
  STRENGTH
  WEIGHT_TRAINING
  CROSSFIT
  CORE_TRAINING
  INDOOR_FITNESS
  FREE_TRAINING
  ELLIPTICAL
  STAIRS_CLIMBING
  JUMP_ROPE
  HULA_HOOP
  // Mind and body
  YOGA
  PILATES
  STRETCHING
  MEDITATION
  GYMNASTICS
  DANCE
  // Climbing
  ROCK_CLIMBING
  // Winter
  SKIING
  CROSS_COUNTRY_SKIING
  SNOWBOARDING
  ICE_SKATING
  FIGURE_SKATING
  SPEED_SKATING
  CURLING
  // Wheels
  ROLLER_SKATING
  SKATEBOARDING
  SCOOTER_RIDING
  // Racket
  TENNIS
  TABLE_TENNIS
  BADMINTON
  // Team ball
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  HANDBALL
  RUGBY
  AMERICAN_FOOTBALL
  BASEBALL
  HOCKEY
  FRISBEE
  // Precision
  GOLF
  BOWLING
  BILLARDS
  ARCHERY
  SHOOTING
  FISHING
  // Combat
  BOXING
  MARTIAL_ARTS
  FENCING
  // Air and riding
  HORSEBACK_RIDING
  SKYDIVING
  // Other
  OTHER

  @@schema("planner")
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
  SKIPPED

  @@schema("planner")
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  startTime   DateTime? @map("start_time") @db.Time
  endTime     DateTime? @map("end_time") @db.Time
  timezone    String    @db.VarChar(64)
  description String?
  location    String?   @db.VarChar(255)
  sportType   SportType @map("sport_type")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Recurrence: the series "root" carries the rule; every occurrence
  // (root included) shares one seriesId, so `WHERE series_id = X` alone
  // returns the whole series.
  recurrenceRule String? @map("recurrence_rule")
  seriesId       String? @map("series_id") @db.Uuid
  series         Event?  @relation("EventSeries", fields: [seriesId], references: [id], onDelete: Cascade)
  occurrences    Event[] @relation("EventSeries")

  planId String? @map("plan_id") @db.Uuid
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  participants EventParticipant[]

  @@index([seriesId])
  @@index([startDate])
  @@index([deletedAt])
  @@map("events")
  @@schema("planner")
}

model EventParticipant {
  eventId String            @map("event_id") @db.Uuid
  userId  String            @map("user_id") @db.Uuid
  status  ParticipantStatus @default(PENDING)

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminders EventReminder[]

  @@id([eventId, userId])
  @@map("event_participants")
  @@schema("planner")
}

model EventReminder {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  minutesBefore Int      @map("minutes_before")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  participant EventParticipant @relation(fields: [eventId, userId], references: [eventId, userId], onDelete: Cascade)

  @@unique([eventId, userId, minutesBefore])
  @@map("event_reminders")
  @@schema("planner")
}

model Plan {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  sportType   SportType @map("sport_type")
  notes       String?
  details     Json
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  events Event[]

  @@index([createdById, sportType])
  @@map("plans")
  @@schema("planner")
}

model PlanPrototype {
  id        String    @id @default(uuid()) @db.Uuid
  sportType SportType @unique @map("sport_type")
  fields    Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("plan_prototypes")
  @@schema("planner")
}
