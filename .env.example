# Copy this file to .env (gitignored) before starting services:
#   cp .env.example .env
#
# App ports come from common/environment.json (not from this file).

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=training_planning
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app@localhost:5432/training_planning

JWT_SECRET=b659226d0be2e690d3ee86e8dcba1c24fb20db8fba2e36188ae75b2d1923b90f

# Outgoing mail (email verification). Locally this is the Mailpit container from
# docker-compose.yml; see sent mail at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Training Planning <no-reply@localhost>"

# Where links in emails point. Defaults to the local planner front.
PLANNER_PUBLIC_URL=
