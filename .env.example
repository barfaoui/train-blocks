# Copy this file to .env (gitignored) before starting services:
#   cp .env.example .env
#
# App ports come from common/environment.json (not from this file).

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=training_planning
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app@localhost:5432/training_planning

JWT_SECRET=jwt_secret
